<Window x:Class="AbsolverModTool.Gui.InstalledModsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installed Mods" Width="560" Height="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="FolderText" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <ListView x:Name="ModsList" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Pak" Width="280" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Remove Selected" Width="120" Margin="0,0,8,0" Click="Remove_Click"/>
            <Button Content="Refresh" Width="80" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Close" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
