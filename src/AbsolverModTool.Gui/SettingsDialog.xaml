<Window x:Class="AbsolverModTool.Gui.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="UnrealPak.exe path"/>
        <DockPanel Margin="0,2,0,8">
            <Button Content="Browse..." DockPanel.Dock="Right" Margin="4,0,0,0" Click="BrowseUnrealPak_Click"/>
            <TextBox x:Name="UnrealPakBox"/>
        </DockPanel>

        <TextBlock Text="Game's Paks folder"/>
        <DockPanel Margin="0,2,0,8">
            <Button Content="Browse..." DockPanel.Dock="Right" Margin="4,0,0,0" Click="BrowseGamePaks_Click"/>
            <TextBox x:Name="GamePaksBox"/>
        </DockPanel>

        <TextBlock Text="Working folder (recipes are applied/packed here - defaults to 'work' next to the app)"/>
        <DockPanel Margin="0,2,0,0">
            <Button Content="Browse..." DockPanel.Dock="Right" Margin="4,0,0,0" Click="BrowseWorkDir_Click"/>
            <TextBox x:Name="WorkDirBox"/>
        </DockPanel>

        <Separator Margin="0,8,0,8"/>
        <CheckBox x:Name="SimpleModeCheck" Content="Simplified Mode" Margin="0,0,0,6" Checked="SimpleModeCheck_Checked"/>
        <CheckBox x:Name="ShowVerifyCheck" Content="Show Verify panel" Margin="0,0,0,6" Checked="ShowVerifyCheck_Checked"/>
        <CheckBox x:Name="ShowPendingEditsCheck" Content="Show Pending Edits panel" Margin="0,0,0,6"/>
        <CheckBox x:Name="ShowResolvedColumnCheck" Content="Show Resolved column" Margin="0,0,0,6"/>
        <CheckBox x:Name="ShowDebugLogCheck" Content="Show debug log in Console (verbose - which handler fired, with what value; useful for bug reports)" Margin="0,0,0,6"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" Width="80" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
