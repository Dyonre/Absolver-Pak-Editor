<Window x:Class="AbsolverModTool.Gui.FinalizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finalize Mod" Width="640" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Mod name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="ModNameBox"/>
        </DockPanel>

        <TextBox x:Name="ConsoleBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CreateButton" Content="Create" Width="90" Margin="0,0,8,0" Click="Create_Click"/>
            <Button x:Name="UndoButton" Content="Undo" Width="90" Margin="0,0,8,0" IsEnabled="False" Click="Undo_Click"/>
            <Button x:Name="DeployButton" Content="Deploy" Width="90" IsEnabled="False" Click="Deploy_Click"/>
        </StackPanel>
    </Grid>
</Window>
