<Window x:Class="AbsolverModTool.Gui.AddArrayElementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Array Slot" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <TextBlock Text="Array to append to"/>
        <ComboBox x:Name="ArrayBox" Margin="0,2,0,8"/>

        <TextBlock Text="New element's value (cloned from the array's last element, then set to this)"/>
        <TextBox x:Name="ValueBox" Margin="0,2,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Add" Width="80" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
